# PostgreSQL connection (local: project-owned instance started by scripts/db-local.sh)
DATABASE_URL="postgresql://gauravcodershive@127.0.0.1:5433/prodplan"
# Used by integration tests (separate database)
TEST_DATABASE_URL="postgresql://gauravcodershive@127.0.0.1:5433/prodplan_test"
# Session signing secret: at least 32 random bytes (openssl rand -base64 48)
AUTH_SECRET="replace-me-with-a-long-random-string"
# Public base URL of the app
APP_URL="http://localhost:3000"
# Optional: Resend API key for outbound email (schedule digest, delivery-risk and order-status alerts, docs/M3_SPEC.md §7).
# Unset in dev/staging by default: emails are logged (not sent) via the log-provider instead. Once set, "from" defaults
# to a resend.dev sandbox address (RESEND_FROM_ADDRESS overrides it) — switch to the client's verified sending domain
# before go-live.
# RESEND_API_KEY="re_xxxxxxxx"
# RESEND_FROM_ADDRESS="ProdPlan <notifications@yourdomain.com>"
# Staging (Netlify): DATABASE_URL is NOT set; the app falls back to NETLIFY_DB_URL injected by Netlify Database.
# Allow the seed script to run against a non-local database (dangerous): SEED_ALLOW=1

# Cloudflare local dev/preview: wrangler emulates the HYPERDRIVE binding with this Postgres. Miniflare insists on a
# password even though the local server uses trust auth, so any value works (= DATABASE_URL with ":local" added).
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="postgresql://USER:local@127.0.0.1:5433/prodplan"
